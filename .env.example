# MarketOS local development only
VITE_API_BASE_URL=http://localhost:7071/api

# Market data. Keep secrets server-side; never expose the API key through VITE_*.
# demo = deterministic built-in provider
# twelvedata = Twelve Data adapter
MARKET_DATA_PROVIDER=demo
TWELVE_DATA_API_KEY=
MARKET_DATA_API_KEY=
MARKETOS_WEB_ORIGIN=http://localhost:5173

# AI chart engine. "local-chart-engine" requires no external key.
# A hosted AI provider can be added behind the same endpoint later.
AI_PROVIDER=local-chart-engine
AI_API_KEY=
