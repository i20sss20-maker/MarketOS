# MarketOS local development only
VITE_API_BASE_URL=http://localhost:7071/api

# Market data. Keep secrets server-side; never expose the API key through VITE_*.
# demo = deterministic built-in provider
# twelvedata = Twelve Data adapter
MARKET_DATA_PROVIDER=demo
TWELVE_DATA_API_KEY=
MARKET_DATA_API_KEY=

# Market events are intentionally independent from the quote provider.
# demo = sample earnings events; twelvedata = /earnings_calendar (paid endpoint on eligible plans)
MARKET_EVENTS_PROVIDER=demo

# Company feed is independent from market data/events.
# demo = local sample company releases; twelvedata = /press_releases
MARKET_FEED_PROVIDER=demo

MARKETOS_WEB_ORIGIN=http://localhost:5173

# AI chart engine. "local-chart-engine" requires no external key.
# A hosted AI provider can be added behind the same endpoint later.
AI_PROVIDER=local-chart-engine
AI_API_KEY=

# User accounts / cloud state.
# memory = local/dev only. cosmos = persistent Azure Cosmos DB.
USER_DATA_PROVIDER=memory
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=marketos
COSMOS_CONTAINER=userState

# Background alert worker. Keep the secret server-side only.
ALERT_WORKER_ENABLED=false
MARKETOS_WORKER_SECRET=
