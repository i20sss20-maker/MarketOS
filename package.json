{
  "name": "marketos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @marketos/web dev",
    "dev:api": "pnpm --filter @marketos/api start",
    "build": "pnpm --filter @marketos/market-core build && pnpm --filter @marketos/formula-core build && pnpm --filter @marketos/strategy-core build && pnpm --filter @marketos/screener-core build && pnpm --filter @marketos/alert-core build && pnpm --filter @marketos/correlation-core build && pnpm --filter @marketos/market-stats-core build && pnpm --filter @marketos/entitlements-core build && pnpm --filter @marketos/web build && pnpm --filter @marketos/api build && pnpm --filter @marketos/alert-worker build",
    "typecheck": "pnpm --filter @marketos/market-core build && pnpm --filter @marketos/formula-core build && pnpm --filter @marketos/strategy-core build && pnpm --filter @marketos/screener-core build && pnpm --filter @marketos/alert-core build && pnpm --filter @marketos/correlation-core build && pnpm --filter @marketos/market-stats-core build && pnpm --filter @marketos/entitlements-core build && pnpm --filter @marketos/web typecheck && pnpm --filter @marketos/api typecheck && pnpm --filter @marketos/alert-worker typecheck",
    "smoke:market": "node scripts/market-smoke.mjs",
    "smoke:ai-chart": "node scripts/ai-chart-smoke.mjs",
    "smoke:events": "node scripts/events-smoke.mjs",
    "smoke:azure": "node scripts/azure-preview-smoke.mjs",
    "prepare:azure-api": "node scripts/prepare-azure-api.mjs",
    "smoke:twelvedata": "node scripts/twelvedata-adapter-smoke.mjs",
    "smoke:provider-live": "node scripts/provider-live-smoke.mjs",
    "smoke:backtest": "node scripts/backtest-smoke.mjs",
    "smoke:formula": "node scripts/formula-smoke.mjs",
    "smoke:feed": "node scripts/feed-smoke.mjs",
    "smoke:feed-provider": "node scripts/feed-provider-smoke.mjs",
    "smoke:screener": "node scripts/screener-smoke.mjs",
    "smoke:multi-timeframe": "node scripts/multi-timeframe-smoke.mjs",
    "smoke:alerts": "node scripts/alerts-smoke.mjs",
    "smoke:correlation": "node scripts/correlation-smoke.mjs",
    "smoke:instrument-stats": "node scripts/instrument-stats-smoke.mjs",
    "smoke:cloud-state": "node scripts/cloud-state-smoke.mjs",
    "smoke:server-alerts": "node scripts/server-alerts-smoke.mjs",
    "smoke:alert-inbox": "node scripts/alert-inbox-smoke.mjs",
    "smoke:web-push": "node scripts/web-push-smoke.mjs",
    "smoke:export-share": "node scripts/export-share-smoke.mjs",
    "smoke:command-palette": "node scripts/command-palette-smoke.mjs",
    "smoke:home-dashboard": "node scripts/home-dashboard-smoke.mjs",
    "smoke:chart-templates": "node scripts/chart-templates-smoke.mjs",
    "smoke:multiple-watchlists": "node scripts/multiple-watchlists-smoke.mjs",
    "smoke:pane-independence": "node scripts/pane-independence-smoke.mjs",
    "smoke:object-tree": "node scripts/object-tree-smoke.mjs",
    "smoke:replay-v2": "node scripts/replay-v2-smoke.mjs",
    "smoke:drawing-alerts": "node scripts/drawing-alerts-smoke.mjs",
    "dev:worker": "pnpm --filter @marketos/alert-worker start",
    "prepare:alert-worker": "node scripts/prepare-alert-worker.mjs",
    "smoke:alert-worker": "node scripts/alert-worker-smoke.mjs",
    "smoke:background-alerts": "node scripts/background-alert-sweep-smoke.mjs",
    "smoke:alert-worker-package": "node scripts/alert-worker-package-smoke.mjs",
    "smoke:entitlements": "node scripts/entitlements-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "20.x"
  }
}
